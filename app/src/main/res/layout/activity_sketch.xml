<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true">

    <!-- Canvas + floating chrome (top bar, empty state, zoom controls) -->
    <FrameLayout
        android:id="@+id/canvasArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <org.example.test.SketchCanvasView
            android:id="@+id/sketchCanvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Top bar. Auto-hides after a few seconds to maximize canvas space for sketching;
             see setupTopBarAutoHide() in SketchActivity. -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_top_bar_button_ripple"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chevron_left"
                android:contentDescription="Back"
                android:elevation="3dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnUndo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_top_bar_button_ripple"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_undo"
                android:contentDescription="Undo"
                android:elevation="3dp" />

            <ImageButton
                android:id="@+id/btnRedo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_top_bar_button_ripple"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_redo"
                android:contentDescription="Redo"
                android:elevation="3dp" />

            <ImageButton
                android:id="@+id/btnMore"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_top_bar_button_ripple"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_more_horiz"
                android:contentDescription="More"
                android:elevation="3dp" />

            <ImageButton
                android:id="@+id/btnPlay"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_top_bar_button_ripple"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play"
                android:contentDescription="Preview"
                android:elevation="3dp" />
        </LinearLayout>

        <!-- The bottom-edge "page height" drag handle previously lived here as a static View
             pinned to the screen bottom. It's now drawn directly inside SketchCanvasView instead
             (see drawPageHandle()/handlePageHandleTouch() there), since it has to track the
             page's actual bottom edge through pan/zoom - something a separate overlay View can't
             do cleanly. -->

    </FrameLayout>

    <!-- Temporary multi-selection actions panel: appears after a long-press + drag marquee
         selection is released over one or more parts (see SketchCanvasView -
         onMultiSelectionFinalized / SketchActivity#showSelectionActionsPanel). It's a small
         floating sidebar docked to the right edge of the canvas - a vertical column of icon
         buttons - not a BottomSheetBehavior sheet, since it's meant to slide in/out over the
         canvas rather than be dragged. Hidden by default; slid in/out from off-screen (right
         edge) entirely in code. -->
    <LinearLayout
        android:id="@+id/selectionActionsPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="16dp"
        android:minWidth="64dp"
        android:orientation="vertical"
        android:background="@drawable/bg_selection_actions_panel"
        android:paddingVertical="6dp"
        android:visibility="invisible"
        android:elevation="12dp">

        <LinearLayout android:id="@+id/actionGroupToggle" style="@style/SketchSelectionSidebarItem">
            <ImageView style="@style/SketchSelectionSidebarIcon" android:src="@drawable/ic_group" />
            <TextView android:id="@+id/actionGroupToggleLabel" style="@style/SketchSelectionSidebarLabel" android:text="Group" />
        </LinearLayout>

        <View style="@style/SketchSelectionSidebarDivider" />

        <LinearLayout android:id="@+id/actionDuplicateSel" style="@style/SketchSelectionSidebarItem">
            <ImageView style="@style/SketchSelectionSidebarIcon" android:src="@drawable/ic_duplicate" />
            <TextView style="@style/SketchSelectionSidebarLabel" android:text="Duplicate" />
        </LinearLayout>

        <View style="@style/SketchSelectionSidebarDivider" />

        <LinearLayout android:id="@+id/actionMoveSel" style="@style/SketchSelectionSidebarItem">
            <ImageView style="@style/SketchSelectionSidebarIcon" android:src="@drawable/ic_move" />
            <TextView style="@style/SketchSelectionSidebarLabel" android:text="Move" />
        </LinearLayout>

        <View style="@style/SketchSelectionSidebarDivider" />

        <LinearLayout android:id="@+id/actionLockToggleSel" style="@style/SketchSelectionSidebarItem">
            <ImageView style="@style/SketchSelectionSidebarIcon" android:src="@drawable/ic_lock" />
            <TextView style="@style/SketchSelectionSidebarLabel" android:text="Lock" />
        </LinearLayout>

        <View style="@style/SketchSelectionSidebarDivider" />

        <LinearLayout android:id="@+id/actionHideToggleSel" style="@style/SketchSelectionSidebarItem">
            <ImageView style="@style/SketchSelectionSidebarIcon" android:src="@drawable/ic_hide" />
            <TextView style="@style/SketchSelectionSidebarLabel" android:text="Hide" />
        </LinearLayout>

        <View style="@style/SketchSelectionSidebarDivider" />

        <LinearLayout android:id="@+id/actionDeleteSel" style="@style/SketchSelectionSidebarItem">
            <ImageView style="@style/SketchSelectionSidebarIcon" android:src="@drawable/ic_delete" />
            <TextView style="@style/SketchSelectionSidebarLabel" android:textColor="#F2B8B5" android:text="Delete" />
        </LinearLayout>
    </LinearLayout>

    <!-- Shared bottom panel: Main tools tab bar stays pinned at the top of the panel; the
         content area beneath it swaps between the (now-empty) default tools content and the
         Components browser. In Select mode the panel shows only the Main tools row - it is
         sized to that row's height (see setupBottomPanel in SketchActivity). The panel has no
         drag handle of its own: it opens via a flick or a double-tap on empty canvas (see
         onFlickEmptySpace / onDoubleTapEmptySpace -> openSketchPanel in SketchActivity) and
         closes via the back button or by swiping it down (app:behavior_draggable="true" lets the
         framework's native swipe-to-dismiss gesture animate it closed - see setupBottomPanel in
         SketchActivity). -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@drawable/bg_bottom_panel"
        android:paddingHorizontal="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_hideable="true"
        app:behavior_draggable="true"
        app:behavior_skipCollapsed="false"
        app:behavior_peekHeight="110dp">

        <!-- Main tools tab navigation (always visible, above both the default tools content and
             the Components browser). -->
        <LinearLayout
            android:id="@+id/mainToolsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/tabSelect"
                style="@style/SketchTabColumn">

                <LinearLayout style="@style/SketchTabPill" android:background="@drawable/bg_tab_selected">
                    <ImageView style="@style/SketchTabIcon" android:src="@drawable/ic_tool_select" />
                    <TextView style="@style/SketchTabLabel" android:text="Select" android:textColor="#FFFFFF" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabShapes"
                style="@style/SketchTabColumn">

                <LinearLayout style="@style/SketchTabPill">
                    <ImageView style="@style/SketchTabIcon" android:src="@drawable/ic_tool_pages" app:tint="#9A9AA5" />
                    <TextView style="@style/SketchTabLabel" android:text="Pages" android:textColor="#9A9AA5" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabText"
                style="@style/SketchTabColumn">

                <LinearLayout style="@style/SketchTabPill">
                    <ImageView style="@style/SketchTabIcon" android:src="@drawable/ic_tool_text" app:tint="#9A9AA5" />
                    <TextView style="@style/SketchTabLabel" android:text="Text" android:textColor="#9A9AA5" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabMedia"
                style="@style/SketchTabColumn">

                <LinearLayout style="@style/SketchTabPill">
                    <ImageView style="@style/SketchTabIcon" android:src="@drawable/ic_tool_upload" app:tint="#9A9AA5" />
                    <TextView style="@style/SketchTabLabel" android:text="Upload" android:textColor="#9A9AA5" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/tabComponents"
                style="@style/SketchTabColumn">

                <LinearLayout style="@style/SketchTabPill">
                    <ImageView style="@style/SketchTabIcon" android:src="@drawable/ic_tool_elements" app:tint="#9A9AA5" />
                    <TextView style="@style/SketchTabLabel" android:text="Elements" android:textColor="#9A9AA5" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- Content area beneath the Main tools row: swaps between defaultToolsContentScroll and
             componentsContentContainer. Weighted to fill the rest of the panel, so it grows when
             the panel is dragged taller (up to full screen) and is what scrolls/clips first when
             the panel is dragged shorter. -->
        <FrameLayout
            android:id="@+id/panelContentContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="14dp"
            android:clipChildren="false">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/defaultToolsContentScroll"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:fillViewport="true">

                <LinearLayout
                    android:id="@+id/defaultToolsContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </androidx.core.widget.NestedScrollView>

            <!-- Components browser content, built and attached at runtime by
                 buildComponentsContent() in ComponentsPanel.kt; hidden until the Components tab
                 is tapped. Lives in the same shared panel as the tools above, beneath the
                 always-visible Main tools row. -->
            <FrameLayout
                android:id="@+id/componentsContentContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
