<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Canvas + floating chrome (top bar, empty state, zoom controls) -->
    <FrameLayout
        android:id="@+id/canvasArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000">

        <org.example.test.SketchCanvasView
            android:id="@+id/sketchCanvas"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Inline editor for the auto-generated object name tag shown above the top-left of
             a selected part's frame. Positioned programmatically over the tag; see
             startNameTagEdit()/commitNameTagEdit() in SketchActivity. -->
        <EditText
            android:id="@+id/nameTagEditor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:background="@null"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:minWidth="40dp"
            android:minHeight="0dp"
            android:textColor="#1D1B20"
            android:textColorHint="#801D1B20"
            android:textCursorDrawable="@null"
            android:singleLine="true"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:visibility="gone"
            android:elevation="12dp" />

        <!-- Top bar. Auto-hides after a few seconds to maximize canvas space for sketching;
             see setupTopBarAutoHide() in SketchActivity. -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_top_bar_button_ripple"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chevron_left"
                android:contentDescription="Back"
                android:elevation="3dp" />

            <!-- Opens/closes the Elements sidebar (elementsSideSheet below). The bottom-bar
                 Elements tab it replaces is gone, so this is the visible entry point; the
                 long-press / double-tap on empty canvas gestures still open it too. -->
            <ImageButton
                android:id="@+id/btnElements"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_top_bar_button_ripple"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_components"
                android:tint="#1D1B20"
                android:contentDescription="Elements"
                android:elevation="3dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageButton
                android:id="@+id/btnUndo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_top_bar_button_ripple"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_undo"
                android:contentDescription="Undo"
                android:elevation="3dp" />

            <ImageButton
                android:id="@+id/btnRedo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_top_bar_button_ripple"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_redo"
                android:contentDescription="Redo"
                android:elevation="3dp" />

            <ImageButton
                android:id="@+id/btnMore"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_top_bar_button_ripple"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_more_horiz"
                android:contentDescription="More"
                android:elevation="3dp" />

            <ImageButton
                android:id="@+id/btnPlay"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_top_bar_button_ripple"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_play"
                android:contentDescription="Preview"
                android:elevation="3dp" />
        </LinearLayout>

        <!-- The bottom-edge "page height" drag handle previously lived here as a static View
             pinned to the screen bottom. It's now drawn directly inside SketchCanvasView instead
             (see drawPageHandle()/handlePageHandleTouch() there), since it has to track the
             page's actual bottom edge through pan/zoom - something a separate overlay View can't
             do cleanly. -->

    </FrameLayout>

    <!-- Temporary multi-selection actions panel: appears after a long-press + drag marquee
         selection is released over one or more parts (see SketchCanvasView -
         onMultiSelectionFinalized / SketchActivity#showSelectionActionsPanel). It's a small
         floating sidebar docked to the left edge of the canvas - a vertical column of icon
         buttons, each with its label stacked directly beneath it - not a BottomSheetBehavior
         sheet, since it's meant to slide in/out over the canvas rather than be dragged. Hidden
         by default; slid in/out from off-screen (left edge) entirely in code. -->
    <LinearLayout
        android:id="@+id/selectionActionsPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="16dp"
        android:minWidth="64dp"
        android:orientation="vertical"
        android:background="@drawable/bg_selection_actions_panel"
        android:paddingVertical="6dp"
        android:visibility="invisible"
        android:elevation="12dp">

        <LinearLayout android:id="@+id/actionGroupToggle" style="@style/SketchSelectionSidebarItem">
            <ImageView style="@style/SketchSelectionSidebarIcon" android:src="@drawable/ic_group" />
            <TextView android:id="@+id/actionGroupToggleLabel" style="@style/SketchSelectionSidebarLabel" android:text="Group" />
        </LinearLayout>

        <View style="@style/SketchSelectionSidebarDivider" />

        <LinearLayout android:id="@+id/actionDuplicateSel" style="@style/SketchSelectionSidebarItem">
            <ImageView style="@style/SketchSelectionSidebarIcon" android:src="@drawable/ic_duplicate" />
            <TextView style="@style/SketchSelectionSidebarLabel" android:text="Duplicate" />
        </LinearLayout>

        <View style="@style/SketchSelectionSidebarDivider" />

        <LinearLayout android:id="@+id/actionMoveSel" style="@style/SketchSelectionSidebarItem">
            <ImageView style="@style/SketchSelectionSidebarIcon" android:src="@drawable/ic_move" />
            <TextView style="@style/SketchSelectionSidebarLabel" android:text="Move" />
        </LinearLayout>

        <View style="@style/SketchSelectionSidebarDivider" />

        <LinearLayout android:id="@+id/actionLockToggleSel" style="@style/SketchSelectionSidebarItem">
            <ImageView style="@style/SketchSelectionSidebarIcon" android:src="@drawable/ic_lock" />
            <TextView style="@style/SketchSelectionSidebarLabel" android:text="Lock" />
        </LinearLayout>

        <View style="@style/SketchSelectionSidebarDivider" />

        <LinearLayout android:id="@+id/actionHideToggleSel" style="@style/SketchSelectionSidebarItem">
            <ImageView style="@style/SketchSelectionSidebarIcon" android:src="@drawable/ic_hide" />
            <TextView style="@style/SketchSelectionSidebarLabel" android:text="Hide" />
        </LinearLayout>

        <View style="@style/SketchSelectionSidebarDivider" />

        <LinearLayout android:id="@+id/actionDeleteSel" style="@style/SketchSelectionSidebarItem">
            <ImageView style="@style/SketchSelectionSidebarIcon" android:src="@drawable/ic_delete" />
            <TextView style="@style/SketchSelectionSidebarLabel" android:textColor="#F2B8B5" android:text="Delete" />
        </LinearLayout>
    </LinearLayout>

    <!-- Elements sidebar: a Material 3 standard side sheet (SideSheetBehavior) docked to the LEFT
         edge, opened from btnElements in the top bar or by long-pressing / double-tapping empty
         canvas space (see openElementsPanel in SketchActivity). It replaces the old Elements
         bottom sheet and its bottom-bar tab. Standard (non-modal) means there is no scrim: the
         sheet only covers its own 320dp, so the rest of the canvas stays visible and tappable
         while it is open. It closes from its own (x), a swipe toward the left edge, Back, or
         after "Insert instance" in the Button page.

         Layout: a fixed "Elements" header, then the 12 element categories as a Material list
         (rows inflated from item_elements_category.xml by bindElementsSidebar() in
         ComponentsPanel.kt). Tapping Buttons swaps the list for the Button setup page
         (elementsButtonPage), which has its own back arrow.

         fitsSystemWindows + the insets listener in SketchActivity#setupElementsSidebar keep it
         clear of the status bar / keyboard, and its bottom margin follows bottomNavBar exactly
         like the bottom sheets do (see applyNavBarPanelMargins). Declared BEFORE bottomNavBar
         and kept at a lower elevation than it, same rule as the other panels below. -->
    <FrameLayout
        android:id="@+id/elementsSideSheet"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="?attr/colorSurfaceContainerLow"
        android:clipChildren="false"
        android:elevation="8dp"
        android:fitsSystemWindows="true"
        android:theme="@style/ThemeOverlay.Test.ElementsSidebar"
        app:layout_behavior="com.google.android.material.sidesheet.SideSheetBehavior">

        <!-- Page 1: header + category list. -->
        <LinearLayout
            android:id="@+id/elementsListPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="24dp"
                android:paddingEnd="12dp">

                <TextView
                    android:id="@+id/elementsSidebarTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityHeading="true"
                    android:text="Elements"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:textColor="?attr/colorOnSurface" />

                <ImageButton
                    android:id="@+id/elementsSidebarClose"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Close Elements"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_close"
                    android:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <com.google.android.material.divider.MaterialDivider
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/elementsCategoryList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp" />
            </ScrollView>
        </LinearLayout>

        <!-- Page 2: Button setup, built at runtime by buildButtonCategoryPanel(). -->
        <FrameLayout
            android:id="@+id/elementsButtonPage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Screens panel: a separate bottom sheet, independent of bottomNavBar, that shows the
         Screens picker (Card/Image/Chip) once the Screens tab is tapped. The page-thumbnails
         row/chevron/(+) tile that used to live at the top of this sheet's content now lives
         outside it, in screenThumbnailsRow below, floating over the canvas instead. Its
         default resting state is a fixed peek height (app:behavior_peekHeight below)
         approximating an on-screen keyboard's height, rather than jumping straight to full
         height - it can still be dragged further up toward full height. Its bottom
         margin is padded out at runtime to bottomNavBar's measured height (see setupScreensPanel
         in SketchActivity) so it sits above the nav bar rather than sliding underneath it.
         Declared (and thus drawn) BEFORE bottomNavBar below, and at a lower elevation than it,
         so that while it's sliding in/out - and even briefly full-height mid-drag - it always
         renders and receives touches behind the nav bar rather than overshadowing it (same rule
         elementsSideSheet follows above). Light-mode surface (bg_bottom_panel) regardless of the
         app's dark canvas chrome. Carries a BottomSheetDragHandleView so the sheet is draggable
         and accessible (e.g. TalkBack expand/collapse actions) without a visible grab affordance -
         it's kept present but invisible rather than removed, since removing it would also drop
         its touch/accessibility hookup. -->
    <FrameLayout
        android:id="@+id/screensPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_bottom_panel"
        android:clipChildren="false"
        android:elevation="8dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_hideable="true"
        app:behavior_draggable="true"
        app:behavior_skipCollapsed="false"
        app:behavior_peekHeight="280dp">

        <!-- Present but not shown: keeps the sheet's drag/accessibility affordance functional
             without drawing the usual visible grab pill. -->
        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:id="@+id/screensPanelDragHandle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:visibility="invisible" />

        <!-- Screens picker content, built and attached at runtime by
             buildScreensPanelContent() in ScreensPanel.kt. -->
        <FrameLayout
            android:id="@+id/screensContentContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false" />
    </FrameLayout>

    <!-- Page thumbnails row: the thumbnails strip, its show/hide chevron, and the trailing (+)
         add-page tile, for the Screens tab. Lives OUTSIDE screensPanel, floating directly above
         it over the canvas - intentionally with no card/frame background of its own, so the
         sketch canvas shows through behind it instead of the panel's white sheet surface.
         Empty here; built at runtime by buildScreenThumbnailsRow() in ScreensPanel.kt (see
         openScreensPanel() in SketchActivity), which also keeps screenThumbnailsContainer
         updated for later refreshes (see refreshScreenThumbnails()). Hidden by default and only
         shown alongside screensPanel; its vertical position is pinned just above screensPanel's
         current top edge - including while the sheet is dragged - by
         positionScreenThumbnailsRow() in SketchActivity. Declared here (before bottomNavBar) so
         it stays behind the nav bar, but given a higher elevation than screensPanel so it draws
         above the sheet it floats over. -->
    <LinearLayout
        android:id="@+id/screenThumbnailsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="14dp"
        android:visibility="gone"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:elevation="9dp" />

    <!-- Button object panel: a separate bottom sheet, independent of screensPanel/textPanel
         and bottomNavBar, shown when a Button part already placed on the sketch Canvas is
         double-tapped or long-pressed (see onButtonPartActivated in SketchActivity, wired from
         SketchCanvasView.Listener). Same two-tier height setup as screensPanel
         above: app:behavior_peekHeight is both its minimum and default resting height, and
         STATE_EXPANDED (match_parent) is its maximum. Empty for now - buttonObjectContentContainer
         is populated at runtime once this panel's content is designed. Declared BEFORE
         bottomNavBar (like the other panel sheets) so it always stays behind the nav bar. -->
    <FrameLayout
        android:id="@+id/buttonObjectPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_bottom_panel"
        android:clipChildren="false"
        android:elevation="8dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_hideable="true"
        app:behavior_draggable="true"
        app:behavior_skipCollapsed="false"
        app:behavior_peekHeight="280dp">

        <!-- Present but not shown: keeps the sheet's drag/accessibility affordance functional
             without drawing the usual visible grab pill, same as the other panels' handles. -->
        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:id="@+id/buttonObjectPanelDragHandle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:visibility="invisible" />

        <!-- Intentionally empty for now - content to be built and attached at runtime later. -->
        <FrameLayout
            android:id="@+id/buttonObjectContentContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false" />
    </FrameLayout>

    <!-- Text panel: a separate bottom sheet, independent of the other panels above, shown once
         the Text tab is tapped - replaces the old auto-add showTextInputDialog() flow (which
         placed a Text part on the Canvas straight from a plain alert dialog). Same two-tier
         height setup as screensPanel: app:behavior_peekHeight below is both its minimum and
         default resting height, and STATE_EXPANDED (match_parent) is its maximum. Follows
         screensPanel's fuller wiring (see setupTextPanel/openTextPanel/closeTextPanel in
         SketchActivity) - status-bar inset top-padding synced while dragging/expanded, and back-
         press/other-panel integration - rather than buttonObjectPanel's simpler one. Intentionally
         empty for now - textContentContainer is populated at runtime once this panel's content is
         designed. Declared BEFORE bottomNavBar (like the other panel sheets) so it always stays
         behind the nav bar. -->
    <FrameLayout
        android:id="@+id/textPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_bottom_panel"
        android:clipChildren="false"
        android:elevation="8dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:behavior_hideable="true"
        app:behavior_draggable="true"
        app:behavior_skipCollapsed="false"
        app:behavior_peekHeight="280dp">

        <!-- Present but not shown: keeps the sheet's drag/accessibility affordance functional
             without drawing the usual visible grab pill, same as the other panels' handles. -->
        <com.google.android.material.bottomsheet.BottomSheetDragHandleView
            android:id="@+id/textPanelDragHandle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:visibility="invisible" />

        <!-- Built and attached at runtime by buildTextPanelContent() (see openTextPanel() in
             SketchActivity) - just the full-width "Add text" action row for now, more content is
             expected to be added below it later. -->
        <FrameLayout
            android:id="@+id/textContentContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false" />
    </FrameLayout>

    <!-- Bottom navigation bar: a plain, always-visible tab bar floating just above the bottom
         edge of the screen as a pill-shaped 3D sheet (NOT a BottomSheetBehavior sheet - it
         never drags, collapses, or hides). Tapping Text/Upload opens its own modal picker/dialog;
         tapping Screens opens screensPanel above, a separate sheet that floats over the
         canvas but always stays visually and interactively behind this bar (see
         setupBottomNavBar / setupScreensPanel in SketchActivity). Elements is no longer a tab:
         it lives in the left-hand elementsSideSheet, opened from the top bar.
         Declared LAST in this file, and given the highest android:elevation of any popup/panel
         here, so it always draws on top of - and always wins touch priority over -
         selectionActionsPanel, elementsSideSheet, screensPanel, and any future panel added above it,
         instead of getting overshadowed by them while they pop up. The extruded ~6dp "sheet
         thickness" is drawn along the TOP
         edge (dark sliver peeking above the lighter face, with its own catch-light) rather
         than the bottom, so paddingTop covers just the tab row's own spacing - it does not
         need the extra bump that paddingBottom needed when the thickness lived down there. -->
    <org.example.test.BottomNavSheetBar
        android:id="@+id/bottomNavBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="20dp"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        android:paddingTop="9dp"
        android:paddingBottom="5dp"
        android:elevation="16dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/tabScreens"
            style="@style/SketchTabColumn">

            <LinearLayout style="@style/SketchTabPill">
                <ImageView style="@style/SketchTabIcon" android:src="@drawable/ic_tool_pages" app:tint="#8A8A94" />
            </LinearLayout>
            <TextView style="@style/SketchTabLabel" android:text="Screens" android:textColor="#8A8A94" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabText"
            style="@style/SketchTabColumn">

            <LinearLayout style="@style/SketchTabPill">
                <ImageView style="@style/SketchTabIcon" android:src="@drawable/ic_tool_text" app:tint="#8A8A94" />
            </LinearLayout>
            <TextView style="@style/SketchTabLabel" android:text="Text" android:textColor="#8A8A94" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabSelect"
            style="@style/SketchTabColumn">

            <LinearLayout style="@style/SketchTabPill">
                <ImageView style="@style/SketchTabIcon" android:src="@drawable/ic_tool_select" app:tint="#1A1B24" />
            </LinearLayout>
            <TextView style="@style/SketchTabLabel" android:text="Select" android:textColor="#1A1B24" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabMedia"
            style="@style/SketchTabColumn">

            <LinearLayout style="@style/SketchTabPill">
                <ImageView style="@style/SketchTabIcon" android:src="@drawable/ic_tool_upload" app:tint="#8A8A94" />
            </LinearLayout>
            <TextView style="@style/SketchTabLabel" android:text="Upload" android:textColor="#8A8A94" />
        </LinearLayout>
    </org.example.test.BottomNavSheetBar>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
