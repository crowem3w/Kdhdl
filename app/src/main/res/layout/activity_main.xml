<?xml version="1.0" encoding="utf-8"?>

<org.example.test.ui.ScrollRevealContainer xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/chartSectionContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#050608">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:gravity="top">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="30dp">

                    <TextView
                        android:id="@+id/symbolText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#EAECEF"
                        android:text="@string/symbol_label" />

                    <org.example.test.ui.SkeletonLoadingView
                        android:id="@+id/symbolSkeleton"
                        android:layout_width="104dp"
                        android:layout_height="24dp"
                        android:layout_gravity="center_vertical"
                        android:visibility="gone" />
                </FrameLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="2dp"
                    android:src="@drawable/ic_chevron_down"
                    android:contentDescription="@null" />

                <org.example.test.ui.RoundedIconButton
                    android:id="@+id/paragraphButton"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_marginStart="10dp"
                    android:src="@drawable/ic_paragraph_symbol"
                    android:scaleType="centerCrop"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/paragraph_button_content_description"
                    app:cornerRadiusPercent="0.15" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#8A96A3"
                    android:text="@string/contract_label" />

                <View
                    android:id="@+id/liveDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_live_dot" />

                <TextView
                    android:id="@+id/liveText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:textSize="13sp"
                    android:textColor="#22D3C5"
                    android:text="@string/live_label" />
            </LinearLayout>

            <org.example.test.ui.PerformanceHudView
                android:id="@+id/performanceHud"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="31dp">

                <TextView
                    android:id="@+id/priceText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="23sp"
                    android:textStyle="bold"
                    android:textColor="#22D3C5"
                    android:gravity="end"
                    tools:text="66,842.5" />

                <org.example.test.ui.SkeletonLoadingView
                    android:id="@+id/priceSkeleton"
                    android:layout_width="116dp"
                    android:layout_height="24dp"
                    android:layout_gravity="end|center_vertical"
                    android:visibility="gone" />
            </FrameLayout>

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="21dp"
                android:layout_marginTop="2dp"
                android:layout_gravity="end">

                <TextView
                    android:id="@+id/changeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="#22D3C5"
                    android:gravity="end"
                    tools:text="+1.23%" />

                <org.example.test.ui.SkeletonLoadingView
                    android:id="@+id/changeSkeleton"
                    android:layout_width="64dp"
                    android:layout_height="16dp"
                    android:layout_gravity="end|center_vertical"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/connectivityBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="8dp"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:background="@drawable/bg_connectivity_banner"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/connectivityBannerText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:textColor="#FFC94D"
            android:lineSpacingExtra="2dp"
            tools:text="Can't reach Bitget. This may be an ISP block rather than a connection problem - try a VPN or a different network." />

        <TextView
            android:id="@+id/connectivityBannerRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FFC94D"
            android:text="@string/connectivity_banner_retry"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/connectivityBannerDismiss"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginStart="2dp"
            android:gravity="center"
            android:textSize="15sp"
            android:textColor="#8A6B1F"
            android:text="@string/connectivity_banner_dismiss"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/chartAndQuickTradeContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/chartCanvas"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="14dp">

            <org.example.test.chart.DepthHeatmapView
                android:id="@+id/depthHeatmap"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                tools:background="#131722" />

            <org.example.test.chart.CandlestickChartView
                android:id="@+id/candleChart"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <org.example.test.ui.DrawingContextToolbar
                android:id="@+id/drawingContextToolbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:visibility="gone" />

            <!--
                Always-on quick-trade drawer handle. Docked to the bottom-center of the
                chart canvas itself (above the timeframe row / drawer, horizontally
                centered on the full screen width) so it stays visible even while the
                drawer is fully collapsed and GONE. Dragging it drives the same reveal
                gesture as the drawer's own internal grab handle; it fades out once the
                drawer is visible so the two handles never show at once (see
                MainActivity#applyQuickTradeProgress).
            -->
            <FrameLayout
                android:id="@+id/quickTradeHandleIndicator"
                android:layout_width="56dp"
                android:layout_height="24dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_quick_trade_handle_backdrop"
                android:clickable="true"
                android:focusable="true">

                <View
                    android:layout_width="32dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_quick_trade_handle_grip" />

            </FrameLayout>

        </FrameLayout>

        <org.example.test.ui.QuickTradePanel
            android:id="@+id/quickTradePanel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0"
            android:layout_marginTop="0dp"
            android:visibility="gone" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/bottomControlsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#050608"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout
            android:id="@+id/timeframeRow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:background="@drawable/bg_timeframe_container"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:gravity="center_vertical" />

        <ImageView
            android:id="@+id/historicalDataButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:padding="9dp"
            android:src="@drawable/ic_historical_data"
            android:contentDescription="@string/historical_data_content_description" />

        <ImageView
            android:id="@+id/drawingToolsButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:padding="9dp"
            android:src="@drawable/ic_drawing_pencil"
            android:contentDescription="@string/drawing_tools_content_description" />
    </LinearLayout>

</org.example.test.ui.ScrollRevealContainer>
