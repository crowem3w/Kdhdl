<?xml version="1.0" encoding="utf-8"?>
<!-- Zaslia is bundled locally as res/font/zaslia_regular.otf (not a Google Fonts
     downloadable family like the Inter set above), so this points straight at the
     packaged file rather than using a fontProviderQuery. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font
        android:fontStyle="normal"
        android:fontWeight="400"
        android:font="@font/zaslia_regular" />
</font-family>
