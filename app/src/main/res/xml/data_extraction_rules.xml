<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) backup/transfer rules.

  The live Bitget API key is stored in EncryptedSharedPreferences
  ("bitget_live_credentials_encrypted", see BitgetLiveCredentialsStore). Its
  Keystore-backed encryption key never leaves this device or this install, so
  a cloud backup or device-to-device transfer of that file would just be an
  undecryptable blob on the other end - but we exclude it outright rather
  than rely on that: real trading credentials shouldn't leave the device at
  all, backup or not.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="bitget_live_credentials_encrypted.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="bitget_live_credentials_encrypted.xml" />
    </device-transfer>
</data-extraction-rules>
