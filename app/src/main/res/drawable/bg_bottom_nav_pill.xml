<?xml version="1.0" encoding="utf-8"?>
<!--
    Pill-shaped "3D sheet" background for bottomNavBar.

    Simulates physical thickness on a flat Android canvas by stacking two fully-rounded
    (stadium/capsule) shapes and offsetting the bottom one downward by the sheet's thickness:
      - Edge layer (bottom): a darker slab, shifted down so a strip of it peeks out below the
        face layer - that visible strip reads as the side wall of an extruded sheet.
      - Face layer (top): the lit top surface, inset from the bottom by the same amount so the
        edge layer shows through beneath it, with a top-to-bottom gradient and a hairline
        stroke to sell the sense of a raised, lit panel.

    Thickness: 3mm ~= 18dp at the 160dpi (mdpi) baseline (3mm / 25.4mm-per-inch * 160dp-per-inch).
    Corner radius is set far larger than the bar's half-height (999dp) so Android clamps it to
    a full stadium/pill shape regardless of the bar's actual height.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Edge / side-wall layer: shifted down by the 3mm (18dp) thickness. -->
    <item android:top="18dp">
        <shape android:shape="rectangle">
            <solid android:color="#0A0A10" />
            <corners android:radius="999dp" />
        </shape>
    </item>

    <!-- Face layer: the visible top surface of the sheet, inset from the bottom by the same
         18dp thickness so the edge layer above peeks out beneath it. -->
    <item android:bottom="18dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:type="linear"
                android:startColor="#24252F"
                android:centerColor="#1A1B24"
                android:endColor="#131319"
                android:centerY="0.4" />
            <corners android:radius="999dp" />
            <stroke android:width="1dp" android:color="#33343F" />
        </shape>
    </item>

</layer-list>
