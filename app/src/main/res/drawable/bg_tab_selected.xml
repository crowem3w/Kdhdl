<?xml version="1.0" encoding="utf-8"?>
<!--
  Active-tab pill. Inverted gradient (darker at the top, lighter at the
  bottom) reads as pressed-in/recessed against the tab bar's raised
  frame — the classic soft-UI pairing of an extruded shell with an
  inset selected control. Colors adapt to light/dark via @color refs.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="14dp" />
    <gradient
        android:angle="270"
        android:startColor="@color/tab_pill_top"
        android:endColor="@color/tab_pill_bottom" />
    <stroke
        android:width="1dp"
        android:color="@color/tab_pill_stroke" />
</shape>
