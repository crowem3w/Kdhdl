<?xml version="1.0" encoding="utf-8"?>
<!--
  Raised "frame" for a standalone floating nav button (back button).
  A top-to-bottom gradient (light catching the top edge, fading to
  shadow at the bottom) plus a hairline stroke reads as a small
  extruded chip sitting above the canvas. Paired with android:elevation
  on the host view for an actual soft cast shadow. Colors come from
  values/colors.xml (light) and values-night/colors.xml (dark), so
  this single file adapts to both automatically.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="oval">
    <gradient
        android:angle="270"
        android:startColor="@color/nav_frame_top"
        android:endColor="@color/nav_frame_bottom" />
    <stroke
        android:width="1dp"
        android:color="@color/nav_frame_stroke" />
</shape>
