<!-- Floating white pill background for the tappable screen-name label in topBar, matching the
     white circular ic_chevron_left/btnBack/etc. buttons' surface so it reads as part of the same
     floating top-bar chrome group (see tvScreenName in activity_sketch.xml). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#FFFFFF" />
    <corners android:radius="20dp" />
</shape>
