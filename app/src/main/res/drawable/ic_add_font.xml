<!-- "Add font" icon: reuses the same ic_tool_text glyph shown elsewhere for the Text tool,
     scaled down and pinned to the top-left, with an outlined add-badge (circle + plus, same
     stroke style as ic_add.xml) pinned to the bottom-right so it overlaps the glyph's stem -
     matching the reference icon. Tints as one flat icon since LayerDrawable applies a single
     color filter across every layer. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="16dp"
        android:height="16dp"
        android:gravity="top|start">
        <bitmap
            android:src="@drawable/ic_tool_text"
            android:gravity="fill" />
    </item>

    <item
        android:width="12dp"
        android:height="12dp"
        android:gravity="bottom|end">
        <vector
            android:width="12dp"
            android:height="12dp"
            android:viewportWidth="12"
            android:viewportHeight="12">
            <path
                android:pathData="M6,0.8 A5.2,5.2 0 1,1 5.99,0.8"
                android:strokeColor="#000000"
                android:strokeWidth="1.4"
                android:fillColor="#00000000" />
            <path
                android:pathData="M6,3.1 L6,8.9 M3.1,6 L8.9,6"
                android:strokeColor="#000000"
                android:strokeWidth="1.4"
                android:strokeLineCap="round"
                android:fillColor="#00000000" />
        </vector>
    </item>
</layer-list>
