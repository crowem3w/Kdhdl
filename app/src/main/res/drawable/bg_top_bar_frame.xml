<?xml version="1.0" encoding="utf-8"?>
<!--
  Raised "frame" for the grouped top-bar action cluster (undo / redo /
  more / play). Same raised-chip technique as bg_nav_button_frame:
  light-to-shadow vertical gradient + hairline stroke, meant to be
  combined with android:elevation on the host LinearLayout for a real
  soft cast shadow underneath the pill. Single file, adapts to
  light/dark via the @color references (values vs values-night).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="24dp" />
    <gradient
        android:angle="270"
        android:startColor="@color/nav_frame_top"
        android:endColor="@color/nav_frame_bottom" />
    <stroke
        android:width="1dp"
        android:color="@color/nav_frame_stroke" />
</shape>
