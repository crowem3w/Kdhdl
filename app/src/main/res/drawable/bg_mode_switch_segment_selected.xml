<?xml version="1.0" encoding="utf-8"?>
<!--
    Highlight for whichever segment ("Design" / "Prototype") is currently active inside the
    dark 3D modeSwitch pill in activity_sketch.xml. Flat white stadium, matching the selected-
    state chip language used elsewhere in the sketch editor (e.g. the white tool-tab pill built
    in SketchActivity#buildPillFillDrawable) rather than the darker 3D-sheet treatment used for
    the pill's own outer shell - so the active segment reads as "lifted" above the dark pill.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="#FFFFFF" />
    <corners android:radius="999dp" />
</shape>
