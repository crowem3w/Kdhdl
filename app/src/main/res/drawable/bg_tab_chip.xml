<?xml version="1.0" encoding="utf-8"?>
<!--
    The selected tab's "rounded-square frame", built as its own tiny extruded sheet using the
    same two-layer trick as bg_bottom_nav_pill (dark edge layer peeking out beneath an inset,
    top-lit face layer) - just at a much smaller scale (2dp of thickness vs. the nav bar's 6dp)
    and in the accent color rather than neutral grey.

    Giving the chip the exact same "physical sheet" construction as the nav bar it floats above
    is what sells the illusion in SketchActivity#setTabVisualState: when it lifts (translationY)
    clear of bg_tab_socket's dent, it doesn't just look like a colour swap, it reads as a
    separate little slab of material hovering above the surface it rose out of.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Edge / underside layer: shifted down by the chip's 2dp thickness. -->
    <item android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#1D3E99" />
            <corners android:radius="14dp" />
        </shape>
    </item>

    <!-- Face layer: the lit top surface, inset from the bottom by the same 2dp so the edge
         layer peeks out beneath it - lightest at the top (nearest the viewer / the light) so
         it reads as convex and raised, the mirror of bg_tab_socket's floor gradient. -->
    <item android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:type="linear"
                android:startColor="#6EA0FF"
                android:centerColor="#4A84FF"
                android:endColor="#3D7EFF"
                android:centerY="0.4" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#88B3FF" />
        </shape>
    </item>

</layer-list>
