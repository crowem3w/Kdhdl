<?xml version="1.0" encoding="utf-8"?>
<!--
    Trompe-l'œil "socket": a shallow dent pressed into the bottom-nav sheet, directly beneath
    the selected tab's chip (see bg_tab_chip.xml). Sits underneath and exactly matches the
    footprint of the pill (see SketchTabSocket/SketchTabSlot in styles_sketch.xml), and is
    faded in/out by SketchActivity#setTabVisualState as the chip lifts off it - the two
    together read as "a tile has risen up out of a hole in the sheet".

    Built the same way bg_bottom_nav_pill fakes extrusion (two offset rounded-rect layers), but
    inverted: instead of a lit face sitting in front of a dark edge peeking out below, here a
    dark rim (the near wall of the dent, in shadow because the sheet folds *away* from the
    viewer) frames a slightly-lighter floor (the far wall of the dent, catching a little bounced
    light) - i.e. the surface reads as bending back into the screen rather than popping out of
    it.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Rim: the full-bleed dark lip of the dent. Left showing only as the thin ring around
         the inset floor layer below. -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#05050A" />
            <corners android:radius="16dp" />
        </shape>
    </item>

    <!-- Floor of the dent: inset from the rim so its dark edge peeks through on every side.
         Darkest at the top (the near wall, folding away from the light) easing to a slightly
         lighter tone at the bottom (the far wall, where the fold bottoms out and catches a
         sliver of ambient light) - the reverse of bg_bottom_nav_pill's face gradient, which is
         lightest at the top. -->
    <item
        android:top="2dp"
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:type="linear"
                android:startColor="#020203"
                android:centerColor="#0E0F17"
                android:endColor="#1C1D29"
                android:centerY="0.35" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#2A2B38" />
        </shape>
    </item>

</layer-list>
