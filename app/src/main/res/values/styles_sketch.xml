<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Main tools tab bar -->
    <style name="SketchTabColumn">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="SketchTabPill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:paddingVertical">8dp</item>
    </style>

    <!-- Wrapper around each tab's pill that also hosts the sunken "socket" drawable (see
         bg_tab_socket.xml) as a same-sized sibling layer behind it. Sized to wrap_content so it
         shrink-wraps to the pill's own footprint - the match_parent socket beneath then
         stretches to that same footprint, keeping the dent perfectly aligned under the chip it
         belongs to regardless of tab. -->
    <style name="SketchTabSlot">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

    <!-- The dent itself: starts invisible (alpha 0) and is only faded in on the selected tab,
         in lockstep with its chip lifting off of it (see setTabVisualState). -->
    <style name="SketchTabSocket">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@drawable/bg_tab_socket</item>
        <item name="android:alpha">0</item>
    </style>

    <style name="SketchTabIcon">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
    </style>

    <style name="SketchTabLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textSize">10.5sp</item>
    </style>

    <!-- Section headers ("Quick Actions", "Properties", "Animation & Interaction") -->
    <style name="SketchSectionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#9A9AA5</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Quick actions row -->
    <style name="SketchQuickAction">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:background">@drawable/bg_quick_action_item_pressed</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="SketchAnimColumn" parent="SketchQuickAction" />

    <style name="SketchQuickActionIcon">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:tint">#D8D8DE</item>
    </style>

    <style name="SketchQuickActionIconFlat" parent="SketchQuickActionIcon" />

    <style name="SketchQuickActionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">#D8D8DE</item>
        <item name="android:textSize">10.5sp</item>
    </style>

    <!-- Sidebar variant of the multi-selection actions panel: a vertical column of icon
         buttons docked to the screen edge instead of a horizontal list of text rows. -->
    <style name="SketchSelectionSidebarItem">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <style name="SketchSelectionSidebarIcon">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
    </style>

    <style name="SketchSelectionSidebarLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="SketchSelectionSidebarDivider">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:background">#2A2B38</item>
    </style>


    <!-- Properties card -->
    <style name="SketchPropertyLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#9A9AA5</item>
        <item name="android:textSize">11.5sp</item>
    </style>

    <style name="SketchPropertyKey">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#9A9AA5</item>
        <item name="android:textSize">12sp</item>
        <item name="android:layout_gravity">center_vertical</item>
    </style>

    <style name="SketchPropertyValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">14sp</item>
        <item name="android:layout_gravity">center_vertical</item>
    </style>

</resources>
