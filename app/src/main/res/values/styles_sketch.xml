<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Main tools tab bar. Column stacks the pill (icon only) above the label, both
         horizontally centered so they stay vertically aligned with each other. -->
    <style name="SketchTabColumn">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center_horizontal</item>
    </style>

    <!-- The rounded-square selection frame. Holds only the icon; equal top/horizontal padding
         keeps the frame's shape and size unchanged. Bottom padding is tightened relative to the
         other three sides specifically to pull the label closer underneath. -->
    <style name="SketchTabPill">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingHorizontal">13dp</item>
        <item name="android:paddingTop">1dp</item>
        <item name="android:paddingBottom">5dp</item>
    </style>

    <style name="SketchTabIcon">
        <item name="android:layout_width">18dp</item>
        <item name="android:layout_height">18dp</item>
    </style>

    <!-- Kept small/tight so the pill stays the dominant shape (visual hierarchy: big icon
         frame, small supporting label). -->
    <style name="SketchTabLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:layout_marginTop">1dp</item>
        <item name="android:textSize">10sp</item>
    </style>

    <!-- Section headers ("Quick Actions", "Properties", "Animation & Interaction") -->
    <style name="SketchSectionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#9A9AA5</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Quick actions row -->
    <style name="SketchQuickAction">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:background">@drawable/bg_quick_action_item_pressed</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="SketchAnimColumn" parent="SketchQuickAction" />

    <style name="SketchQuickActionIcon">
        <item name="android:layout_width">20dp</item>
        <item name="android:layout_height">20dp</item>
        <item name="android:tint">#D8D8DE</item>
    </style>

    <style name="SketchQuickActionIconFlat" parent="SketchQuickActionIcon" />

    <style name="SketchQuickActionLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">#D8D8DE</item>
        <item name="android:textSize">10.5sp</item>
    </style>

    <!-- Sidebar variant of the multi-selection actions panel: a vertical column of icon
         buttons docked to the screen edge instead of a horizontal list of text rows. -->
    <style name="SketchSelectionSidebarItem">
        <item name="android:layout_width">56dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:foreground">?attr/selectableItemBackground</item>
    </style>

    <style name="SketchSelectionSidebarIcon">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
    </style>

    <style name="SketchSelectionSidebarLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">5dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="SketchSelectionSidebarDivider">
        <item name="android:layout_width">32dp</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_gravity">center_horizontal</item>
        <item name="android:background">#2A2B38</item>
    </style>


    <!-- Properties card -->
    <style name="SketchPropertyLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#9A9AA5</item>
        <item name="android:textSize">11.5sp</item>
    </style>

    <style name="SketchPropertyKey">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#9A9AA5</item>
        <item name="android:textSize">12sp</item>
        <item name="android:layout_gravity">center_vertical</item>
    </style>

    <style name="SketchPropertyValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">6dp</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">14sp</item>
        <item name="android:layout_gravity">center_vertical</item>
    </style>

    <!-- Pins the Elements sidebar (elementsSideSheet) to Material 3 light-surface tokens, no
         matter which mode ThemeManager is in. Every other panel in the sketch screen is a light
         surface over the dark canvas chrome, and the Button page inside the sidebar is light too,
         so the sidebar follows suit. Only the tokens the sidebar actually reads are set; the rest
         (shapes, type scale, etc.) still come from Theme.Test / Material 3. Applied with
         android:theme on the sheet, so it also reaches the rows inflated at runtime. -->
    <style name="ThemeOverlay.Test.ElementsSidebar" parent="">
        <item name="colorSurfaceContainerLow">#F7F2FA</item>
        <item name="colorOnSurface">#1D1B20</item>
        <item name="colorOnSurfaceVariant">#49454F</item>
        <item name="colorOutlineVariant">#CAC4D0</item>
        <item name="colorControlHighlight">#1F49454F</item>
    </style>
</resources>
